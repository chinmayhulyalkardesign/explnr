# Copy to .env for local development.
#
# DATABASE_URL: used at runtime by the app. Point it at a pooled connection
# string if your provider offers one (Vercel Postgres / Neon: the
# "pooled connection" / POSTGRES_PRISMA_URL string) — serverless deployments
# can spin up many concurrent function instances, each holding its own
# connection, and pooling keeps that from exhausting the database.
DATABASE_URL="postgresql://user:password@localhost:5432/explnr"

# DIRECT_URL: used only by `prisma migrate`/`prisma generate` at build/deploy
# time. Migrations run DDL, which shouldn't go through a transaction-mode
# pooler — this should be the direct (unpooled) connection string. If your
# database has no pooler (e.g. plain local Postgres), omit this and
# DATABASE_URL is used for both.
# DIRECT_URL="postgresql://user:password@localhost:5432/explnr"
