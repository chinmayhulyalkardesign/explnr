generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  FIXED
  VARIABLE
}

enum ExpenseType {
  DEBIT
  CREDIT
}

model Category {
  id            String           @id @default(cuid())
  name          String           @unique
  type          CategoryType
  monthlyBudget Float
  archived      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  expenses      Expense[]
  budgets       CategoryBudget[]
}

// Per-month override of a category's budget ("YYYY-MM"). When absent for a
// given month, the category's own `monthlyBudget` is used as the default.
// Editing this never rewrites what a past month's budget was — only that
// month's override changes.
model CategoryBudget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
}

model Income {
  id        String   @id @default(cuid())
  source    String
  amount    Float
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model Expense {
  id          String      @id @default(cuid())
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Float
  type        ExpenseType @default(DEBIT)
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())

  @@index([categoryId])
  @@index([date])
}

// One row per calendar month ("YYYY-MM"). Manually-entered running total of
// unbilled credit card spend — money that will be billed *next* month, so
// it's tracked for visibility but deliberately excluded from this month's
// income/spend/budget math.
model MonthlyUnbilled {
  id        String   @id @default(cuid())
  month     String   @unique
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt
}
